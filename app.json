{
  "expo": {
    "name": "CRM Projects",
    "slug": "CrmProjectsApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1565C0",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.m.gamel.CrmProjectsApp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "CRM Projects",
      "shortName": "CRM",
      "lang": "ar",
      "themeColor": "#1565C0",
      "backgroundColor": "#F5F7FA",
      "display": "standalone",
      "orientation": "portrait",
      "scope": "/CrmProjectsApp/",
      "startUrl": "/CrmProjectsApp/",
      "baseUrl": "/CrmProjectsApp/"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "السماح بالوصول إلى الكاميرا لالتقاط صور أثناء الزيارة",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1565C0",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b7f82206-bc3a-4086-982e-0173cfe8735f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b7f82206-bc3a-4086-982e-0173cfe8735f"
    }
  }
}
